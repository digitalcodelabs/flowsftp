{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "flowsftp",
  "version": "0.1.0",
  "identifier": "com.flowsftp.app",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run generate"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FlowSFTP",
        "width": 1440,
        "height": 900,
        "minWidth": 950,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 digital code labs s.r.l.",
    "publisher": "digital code labs s.r.l.",
    "category": "DeveloperTool",
    "shortDescription": "Modern dual-pane SFTP and FTP client with integrated SSH terminal",
    "longDescription": "FlowSFTP is a high-performance, modern dual-pane SFTP and FTP client with integrated hardware-accelerated SSH terminal, developed by digital code labs s.r.l.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}